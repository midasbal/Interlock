{
  "name": "interlock",
  "version": "0.1.0",
  "description": "A safety-gated execution layer for autonomous onchain agents, built on KeeperHub.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "gate:case-a": "node --env-file=.env --import tsx agent/src/run-case-a.ts",
    "gate:case-b": "node --env-file=.env --import tsx agent/src/run-case-b.ts",
    "agent:reliability-arc": "node --env-file=.env --import tsx agent/src/run-reliability-arc.ts",
    "agent:containment-case": "node --env-file=.env --import tsx agent/src/run-containment-case.ts",
    "gate:token-approve": "node --env-file=.env --import tsx agent/src/run-token-approve.ts",
    "gate:token-revoke": "node --env-file=.env --import tsx agent/src/run-token-revoke.ts",
    "gate:contract-policy-block": "node --env-file=.env --import tsx agent/src/run-contract-policy-block.ts",
    "defense:approval-revoke": "node --env-file=.env --import tsx agent/src/run-outbound-approval-revoke.ts",
    "gate:effect-match": "node --env-file=.env --import tsx agent/src/run-effect-verification-match.ts",
    "gate:effect-mismatch": "node --env-file=.env --import tsx agent/src/run-effect-verification-mismatch.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
