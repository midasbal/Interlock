{
  "name": "interlock",
  "version": "0.1.0",
  "description": "A safety-gated execution layer for autonomous onchain agents, built on KeeperHub.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "gate:case-a": "node --env-file=.env --import tsx agent/src/run-case-a.ts",
    "gate:case-b": "node --env-file=.env --import tsx agent/src/run-case-b.ts",
    "agent:reliability-arc": "node --env-file=.env --import tsx agent/src/run-reliability-arc.ts",
    "agent:containment-case": "node --env-file=.env --import tsx agent/src/run-containment-case.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
